{
  "name": "wishmail",
  "version": "0.5.3",
  "private": true,
  "description": "WISHMail — certified mail for agents on Hedera. Monorepo root; the specification in spec/ is the normative document.",
  "license": "Apache-2.0",
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "provision": "npm run provision --workspace app",
    "probe": "npm run probe --workspace app",
    "p13:check": "node scripts/p13-check.mjs",
    "check:register": "node scripts/extract-and-diff.mjs",
    "check:seal": "npm run check:seal --workspace app",
    "check:schemas": "npm run check:schemas --workspace app",
    "check:vectors": "npm run check:vectors --workspace app",
    "check:store": "npm run check:store --workspace app",
    "check:mcp": "npm run check:mcp --workspace app"
  }
}
