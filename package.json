{
  "name": "wishmail",
  "version": "0.5.9",
  "private": true,
  "description": "WISHMail — certified mail for agents on Hedera. Monorepo root; the specification in spec/ is the normative document.",
  "license": "Apache-2.0",
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "provision": "npm run provision --workspace app",
    "probe": "npm run probe --workspace app",
    "p13:check": "node scripts/p13-check.mjs",
    "check:register": "node scripts/extract-and-diff.mjs",
    "check:seal": "npm run check:seal --workspace app",
    "check:schemas": "npm run check:schemas --workspace app",
    "check:vectors": "npm run check:vectors --workspace app",
    "check:store": "npm run check:store --workspace app",
    "check:mcp": "npm run check:mcp --workspace app",
    "conformance": "node conformance/runner.mjs",
    "conformance:scaffold": "node conformance/scaffold.mjs",
    "check:suite": "node conformance/scaffold.mjs --check",
    "check:report": "node conformance/report.check.mjs",
    "check:hcs14": "npm run check:hcs14 --workspace app",
    "check:chunk": "npm run check:chunk --workspace app",
    "check:envelope": "npm run check:envelope --workspace app",
    "check:letter": "npm run check:letter --workspace app",
    "check:hcs10": "npm run check:hcs10 --workspace app",
    "check:freeze": "npm run check:freeze --workspace app",
    "check:prefreeze": "npm run check:prefreeze --workspace app",
    "counter": "npm run counter --workspace app",
    "correspondent": "npm run correspondent --workspace app",
    "correspondent:provision": "npm run correspondent:provision --workspace app",
    "check:correspondent": "npm run check:correspondent --workspace app",
    "demo:operators": "npm run demo:operators --workspace app",
    "entities:md": "node scripts/entities-md.mjs",
    "check:entities": "node scripts/entities-md.mjs --check"
  }
}
