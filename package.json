{
  "name": "wishmail",
  "version": "0.5.2",
  "private": true,
  "description": "WISHMail — certified mail for agents on Hedera. Monorepo root; the specification in spec/ is the normative document.",
  "license": "Apache-2.0",
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "provision": "npm run provision --workspace app",
    "probe": "npm run probe --workspace app",
    "p13:check": "git grep -nE '(AGENT|TREASURY)_DER_KEY' -- app/src | grep -v '^app/src/ops/(env|identity).ts:'; test $? -eq 1"
  }
}
