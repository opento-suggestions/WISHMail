{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wishmail:app:0.5:tool:verify:input",
  "title": "verify input",
  "description": "§6.7 — verify(scope, window?, narrative = false) -> EvidenceBundle (+ Narrative). Preconditions: none. verify requires no key, stamp, account, or credential (P-4, T-P4-1).",
  "type": "object",
  "properties": {
    "scope": {
      "description": "§6.7: {lane} | {envelopeId, lane} | {topics: [...]}.",
      "oneOf": [
        {
          "type": "object",
          "properties": { "lane": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } },
          "required": ["lane"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "envelopeId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "lane": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
          },
          "required": ["envelopeId", "lane"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "topics": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
            }
          },
          "required": ["topics"],
          "additionalProperties": false
        }
      ]
    },
    "window": {
      "type": "object",
      "description": "§11.2's ingestion window. Consensus timestamps, seconds.nanos.",
      "properties": {
        "from": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "to": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      },
      "required": ["from", "to"],
      "additionalProperties": false
    },
    "narrative": { "type": "boolean", "default": false, "description": "§11.7." }
  },
  "required": ["scope"],
  "additionalProperties": false
}
