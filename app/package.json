{
  "name": "@wishmail/app",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "The reference implementation. Provisioning scripts under src/ops/ stand up the Postmaster's entities on hedera:testnet.",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "provision": "tsx src/ops/provision.ts",
    "probe": "tsx src/ops/probe.ts",
    "provision:plan": "tsx src/ops/provision.ts --dry-run",
    "check:seal": "tsx src/core/seal.check.ts",
    "check:schemas": "tsx src/schema/loader.check.ts",
    "vectors": "tsx src/vectors/generate.ts",
    "check:vectors": "tsx src/vectors/vectors.check.ts",
    "check:store": "tsx src/state/store.check.ts",
    "check:mcp": "tsx src/mcp/server.check.ts",
    "mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.81.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^4.0.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
