# ============================================================
# WISHMail Environment Configuration
# ============================================================
#
# Names only. Every value here is blank on purpose: this file is committed and
# `.env` is not (`.gitignore`: `.env*` with `!.env.example` negated back in).
#
# P-13 and CLAUDE.md §3: no private-key material in any committed file, in
# `spec/pins.json`, in the ops record, in a commit message, or in a log line.
# Where each private key was generated and where it lives is recorded per role
# in `app/OPERATIONS.md` — the location, never the material.
#
# The three account roles are D-140. The namespaces are load-bearing, not
# cosmetic: T-P13-1 tests that the service's key store and code path hold no
# agent private-key material, so no Postmaster service path may read AGENT_*.

# ------------------------------------------------------------
# Operator / payer (D-140)
# Pays every network fee (§3.5, §4.6, D-47); `payTo` for the money leg of a
# purchase (§14.2); momentary bearer of the first-contact stamp (§4.4); holds
# the price topic's submit and admin keys (D-142).
# ------------------------------------------------------------
OPERATOR_ID=
OPERATOR_DER_KEY=
OPERATOR_HEX_KEY=
OPERATOR_EVM_ADDR=

# ------------------------------------------------------------
# Treasury (D-140)
# Holds the unissued $POSTAGE supply (§4.1); receives affixed postage (§4.3),
# doorbell fees (§4.4), and the return-receipt fee inside postage (§14.1).
# This key is HOT: §14.2's purchase is atomic, so it signs the stamp leg of
# every buy_stamp. The split from the operator is containment and accounting,
# not cold custody.
# ------------------------------------------------------------
TREASURY_ID=
TREASURY_DER_KEY=

# ------------------------------------------------------------
# Postmaster-agent (D-140)
# The service's own Correspondent identity — an operational choice, not a spec
# role (§1.4 gives POSTMASTER no doorbell and no profile obligation).
#
# NO POSTMASTER SERVICE CODE PATH READS THESE. The namespace exists so that
# T-P13-1's check is structural rather than a matter of intention.
# ------------------------------------------------------------
AGENT_ID=
AGENT_DER_KEY=

# ------------------------------------------------------------
# Network endpoints
# Reads are mirror-node REST and nothing else (STATUS §5, app/OPERATIONS.md):
# P-3 makes replay a function of public consensus data and P-4 forbids a
# broker, which together make a mirror node a read interface, not a broker.
# ------------------------------------------------------------
HEDERA_NETWORK=testnet
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1

# ------------------------------------------------------------
# Provisioned entities (D-144)
# Convenience copies for the running service. The record of what exists is
# `app/deployment/hedera-testnet.json`, and the record of the stamp token is
# `spec/pins.json` — §18.4 enumerates what belongs there and nothing else does.
# ------------------------------------------------------------
POSTAGE_TOKEN_ID=
PRICE_TOPIC_ID=
AGENT_DOORBELL_TOPIC_ID=
AGENT_LOG_TOPIC_ID=
AGENT_MANIFEST_TOPIC_ID=
